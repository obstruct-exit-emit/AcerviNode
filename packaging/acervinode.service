[Unit]
Description=AcerviNode - debrid download client
Documentation=https://github.com/obstruct-exit-emit/AcerviNode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acervinode
Group=acervinode
ExecStart=/opt/acervinode/acervinode
Environment=ACERVINODE_CONFIG=/etc/acervinode/config.yaml
# always, not on-failure: the settings UI's "Restart now" action (used after
# a port/data_dir/TLS change) exits cleanly (code 0), which on-failure would
# treat as "done," not "restart me" — see docs/configuration.md's TLS section.
Restart=always
RestartSec=5

# Hardening — AcerviNode reads and writes its config under /etc/acervinode
# (see below) and its data and download directories under
# /var/lib/acervinode; everything else stays read-only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /etc/acervinode has to be writable, not merely readable: AcerviNode
# persists every live settings change by rewriting its own config.yaml —
# the TorBox API key set from the Settings UI, a category path, a changed
# poll interval. It also writes during an ordinary startup, before the
# server is even listening, when the one-time default-category seeding
# runs. Without it here, ProtectSystem=strict makes that write fail, the
# process exits 1 having served nothing, and Restart=always turns that
# into a permanent restart loop — a stock install following
# docs/installation.md exactly would never start at all. Found doing
# precisely that on a clean machine.
ReadWritePaths=/var/lib/acervinode /etc/acervinode

[Install]
WantedBy=multi-user.target
