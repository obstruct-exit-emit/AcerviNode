[Unit]
Description=AcerviNode - debrid download client
Documentation=https://github.com/obstruct-exit-emit/AcerviNode
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acervinode
Group=acervinode
ExecStart=/opt/acervinode/acervinode
Environment=ACERVINODE_CONFIG=/etc/acervinode/config.yaml
# always, not on-failure: the settings UI's "Restart now" action (used after
# a port/data_dir/TLS change) exits cleanly (code 0), which on-failure would
# treat as "done," not "restart me" — see docs/configuration.md's TLS section.
Restart=always
RestartSec=5

# Hardening — AcerviNode only needs to read its config under /etc/acervinode
# and read/write its data and download directories under /var/lib/acervinode;
# everything else stays read-only.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/acervinode

[Install]
WantedBy=multi-user.target
