# Binaries
/acervinode
/acervinode.exe
/dist/
/bin/

# Go
*.test
*.out
/vendor/

# Frontend (dist is embedded via go:embed; only .gitkeep is committed)
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep

# Runtime data (never commit a live database or config)
*.db
*.db-wal
*.db-shm
config.yaml

# Test payloads. Handy to keep a real .torrent/.nzb next to the repo when
# exercising the add form, and neither belongs in git: they are someone
# else's content, and an .nzb in particular embeds indexer credentials in
# its article headers.
/*.torrent
/*.nzb

# Personal Claude Code settings
.claude/settings.local.json

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
.DS_Store
*.tsbuildinfo
